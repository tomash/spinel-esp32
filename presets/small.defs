# presets/small.defs -- presets/default.defs plus the knobs from spinel's
# small-target switches (matz/spinel#11513, upstream since cd8f80f15, so in
# the vendored pin). Format and consumers: see presets/default.defs.
#
# Opt-in, for really constrained parts: SPINEL_PRESET=small, and add
# SPINEL_FLAGS=--no-bigint for the matching compiler switch (Integer
# overflow then raises instead of growing a Bignum, and a value that can
# only be a Bignum is a compile error).
#
# Measured on the T-OI Plus, wifi_status idle free heap: default preset
# 90.6 KB; this preset with --no-bigint 102.9 KB.

# Allocation report compiled out entirely: drops the stats and type-name
# tables (4 KB, not sized by any knob) and the reporter's constructor and code.
SP_NO_ALLOC_REPORT

# Fiber stack cache table sized for the 2 it keeps instead of 1024 (8 KB).
SP_FIBER_STACK_CACHE_MAX=2

# --- presets/default.defs, verbatim (see there for the reasons) ---
SP_ALLOC_STATS=1
SP_GC_STACK_MAX=512
SP_GC_REMEMBERED_MAX=32
SP_GC_PINNED_MAX=32
SP_STR_SHAPE_MAX=32
SP_DYN_SYMS_MAX=64
SP_GC_MARK_STACK_MAX=128
SP_EXC_STACK_MAX=8
SP_CATCH_STACK_MAX=4
SP_MAX_WORKERS=1
SP_FIBER_STACK_CACHE=2
